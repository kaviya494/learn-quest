# =============================================================================
# AI Peer Teaching Kit - Environment Variables
# =============================================================================
#
# NOTE FOR CLIENT-SIDE BROWSER EXECUTION:
# Because this project runs directly in the browser by double-clicking index.html
# without a Node.js/backend server, you can configure your API key in two ways:
#
# METHOD 1 (Recommended UI):
# Click the "🔑 API Key" button in the top navigation bar of the website,
# paste your Gemini API key, and click Save. It will be stored securely in localStorage.
#
# METHOD 2 (File-based):
# Edit "env.js" in the root folder and set:
# window.ENV = {
#   GEMINI_API_KEY: "YOUR_GEMINI_API_KEY_HERE"
# };
#
# =============================================================================

# Optional: Google Gemini API Key for live AI answers and dynamic topic generation
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# App Environment (development / production)
APP_ENV=development
